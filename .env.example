# ==================== DeepSeek API 配置（对应你图里的第一块） ====================
# 申请地址（和你图里一致）：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-api-key-here  # 🔴 这里是占位符！真实Key要填到.env里，这里不能改
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat  # 默认用最便宜的聊天模型，适合开发测试

# ==================== 应用配置（对应你图里的第二块） ====================
APP_ENV=development  # 开发环境，部署到服务器改成production
LOG_LEVEL=INFO  # 日志级别：DEBUG（最详细）→ INFO → WARNING → ERROR（最简洁）
DATA_DIR=./data  # 放原始数据（你之前的sample_data.csv、cali_housing.csv都在这里）
MODEL_DIR=./data/models  # 存训练好的模型（后面Optuna调优后的XGBoost模型会存这里）

# ==================== Streamlit 前端配置（对应你图里的第三块，后面做可视化页面用） ====================
STREAMLIT_SERVER_PORT=8501  # 前端页面端口（默认8501）
STREAMLIT_SERVER_ADDRESS=0.0.0.0  # 0.0.0.0表示允许局域网访问，127.0.0.1表示仅本机访问